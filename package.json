{
  "name": "fws-api",
  "version": "4.1.0",
  "engines": {
    "node": "22.x"
  },
  "description": "",
  "main": "index.js",
  "scripts": {
    "lint": "standard",
    "test": "npm run lint && npm run unit-test",
    "unit-test": "lab test -v -c --coverage-path lib -r console -o stdout -r lcov -o coverage/lcov.info -r junit -o test/output-unit.xml",
    "validate-config": "node lib/config.js",
    "prepare": "husky install",
    "bootstrap-debug": "docker/scripts/non-dev-container-bootstrap.sh",
    "teardown": "docker/scripts/teardown.sh"
  },
  "author": "DEFRA",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-ec2": "3.1016.0",
    "@aws-sdk/client-sns": "3.1016.0",
    "joi": "18.0.1",
    "js2xmlparser": "5.0.0",
    "lodash.escape": "4.0.1",
    "lodash.unescape": "4.0.1",
    "moment": "2.30.1",
    "moment-timezone": "0.6.0",
    "pg": "8.16.3",
    "xml2js": "0.6.2",
    "xmlbuilder": "15.1.1"
  },
  "devDependencies": {
    "@hapi/code": "9.0.3",
    "@hapi/lab": "26.0.0",
    "aws-sdk-client-mock": "4.1.0",
    "husky": "9.1.7",
    "sinon": "21.0.0",
    "standard": "17.1.2"
  }
}
